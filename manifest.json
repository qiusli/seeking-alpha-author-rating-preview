{
  "manifest_version": 3,
  "name": "Seeking Alpha Article Research Preview",
  "version": "1.1.1",
  "description": "Hover an author or Financials label on a Seeking Alpha article to preview ratings and financial statements.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": ["https://seekingalpha.com/*", "https://api.nasdaq.com/*"],
  "permissions": ["activeTab", "scripting"],
  "action": { "default_popup": "popup.html", "default_title": "Open financials" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_start"
  }]
}
